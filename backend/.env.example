# Tavily API key for "Find contact" web search (get one at https://tavily.com). Optional.
# TAVILY_API_KEY=your_tavily_api_key_here

# Google OAuth for Sign in with Google (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match exactly what you add under "Authorized redirect URIs" in Google Cloud (usually the API origin, not Vite).
BACKEND_URL=http://localhost:8000
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Where users open the app — must match the browser URL (http://127.0.0.1:5173 vs http://localhost:5173 matters for cookies).
FRONTEND_URL=http://localhost:5173
# Comma-separated origins for CORS when public (e.g. https://outreach.yucg.org). If unset, localhost is used.
# CORS_ORIGINS=https://your-frontend-domain.com

# JWT secret for session tokens and OAuth state signing. Required — the API will not start with this placeholder.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional. Unused until P2 Postgres. SQLite file backend/clientreach.db is the store today.
# DATABASE_URL=postgresql://user:pass@localhost:5432/clientreach
# Or set DB_HOST / DB_USER / DB_PASSWORD / DB_NAME / DB_PORT (RDS secret fields).
# CATALOG_BUCKET=yucg-outreach-dev
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_RANK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_ALLOWED_MODEL_IDS=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_CALLS_PER_CLUB_PER_HOUR=200
# ASSISTANT_REQUESTS_PER_MEMBER_PER_HOUR=15
# ASSISTANT_REQUESTS_PER_CLUB_PER_HOUR=120
# BEDROCK_INPUT_USD_PER_MILLION=1.00
# BEDROCK_OUTPUT_USD_PER_MILLION=5.00
# Find people chats skip Bedrock and fill the form. Document questions still use Haiku.
# Amazon Nova Micro is ~30x cheaper than Haiku 4.5 for leftover JSON routing, but production IAM
# currently allows Haiku only. Do not point BEDROCK_MODEL_ID at Nova until the allowlist is reviewed.
# VERIFALIA_API_KEY=
# External mailbox verification (optional, default off). 25 free credits per UTC day;
# the application never purchases credits or upgrades the plan. When credits are
# exhausted it records inconclusive and keeps local DNS/MX results.
# EXTERNAL_EMAIL_VERIFICATION_ENABLED=false
# VERIFALIA_DAILY_CREDIT_CAP=25
# VERIFALIA_RESPONSE_CACHE_DAYS=14
# Microsoft Graph (optional). Club OneDrive/Excel. Do not commit a token.
# GRAPH_ACCESS_TOKEN=
# GRAPH_DRIVE_FOLDER=/YUCG
# CAMPAIGN_DRAIN_LIMIT=5
# CAMPAIGN_DAILY_SEND_LIMIT=100
# Optional: separate HMAC key for OAuth `state` only (defaults to JWT_SECRET)
# OAUTH_STATE_SECRET=

# Seconds between Gmail sends in one campaign batch (deliverability / quota). Default 2.
# CAMPAIGN_SEND_DELAY_SEC=2
# INBOX_VERIFY_MODE=mx   fast — DNS/MX only (default on the box; Amazon throttles port 25)
# INBOX_VERIFY_MODE=auto skip SMTP for trusted aligned scrapes only
# INBOX_VERIFY_MODE=smtp slow — catch-all + RCPT probe per mailbox
# INBOX_VERIFY_PROVIDER=smtp   nightly roster checks: in-house SMTP (verifalia only if explicitly set)
# ROSTER_PROVIDER_VERIFY=1     0 disables the nightly recipient probe
# ROSTER_PROVIDER_ATTEMPTS=25  max in-house RCPT checks per nightly pass
# VERIFY_AGENTS=40
# DISCOVERY_JOBS=1           HTML crawls at once (default 1 under 3 GiB RAM). Tavily/Apify/Bedrock stay ungated.
# DISCOVERY_QUEUE_LIMIT=20   queued + running searches across the club; one active search per member.
# DISCOVERY_LEASE_MINUTES=30  active job heartbeat lease; expired work can be recovered once.
# DISCOVERY_MAX_ATTEMPTS=2    includes the initial attempt; then require an explicit new search.
# Club-wide officer roster (SEC Form 4 + optional IR snippets). Not a paid people database.
# ROSTER_VERIFY_DAYS=7        re-check public-company officers this often
# ROSTER_DRAIN_LIMIT=8        companies refreshed per minute
# ROSTER_LEFT_AFTER_MISSES=2  mark left after this many empty SEC checks
# ROSTER_SEC_PAUSE_SEC=0.12   stay under SEC fair-access (10 requests/sec)
# SEC_CONTACT_EMAIL=you@yucg.org  REQUIRED - SEC EDGAR 403s the code's placeholder
# fallback (outreach@localhost); without a real address here, every SEC officer
# lookup silently returns zero, for every company, with no visible error.
# SEC_USER_AGENT=YUCGOutreach roster-watch you@yucg.org  optional override of the full header
# ROSTER_WEB_ON_ENROLL=0      1 = one Tavily leadership search when no CIK (costs credits)
# ROSTER_EMAIL_RECHECK_DAYS=30  re-run MX/pattern maintenance on a roster this often
# ROSTER_EMAIL_DRAIN_LIMIT=10   rosters email-checked per 5-minute pass
# COMPANIES_HOUSE_API_KEY=       free key: developer.company-information.service.gov.uk (UK officer register)
# ROSTER_DOMAIN_LOOKUPS=4       domain lookups per roster pass (seed URL free; set 0 to disable)
# ROSTER_DOMAIN_WEB=1           1 = one 'official website' Tavily query per domain-less roster
# ROSTER_ADJ_LIMIT=2            LLM roster adjudications per 20-min pass (0 disables; uses Bedrock budget)
# SMTP_PROBE_TIMEOUT=1.5
# SMTP_MAX_CONCURRENT=6
# YUCG_CORPUS_PATH=data/yucg_website_corpus.txt
# YUCG_PROSPECT_XLSX=data/YUCG_Prospect_List.xlsx
# AI_REVIEW_ENABLED=true
# AI_REVIEW_BATCH=8          contacts per agent batch
# AI_REVIEW_WORKERS=6

# Slack (optional). The club Slack app does three things: sign-in/install,
# digest DMs, and the /yucg helper members talk to.
# (1) Install: Profile -> Connect Slack. Client ID + Client Secret from
#     api.slack.com/apps -> your app -> Basic Information -> App Credentials.
#     Redirect URL (OAuth & Permissions) must be exactly:
#       $BACKEND_URL/api/auth/slack/callback
#     Bot scopes requested: chat:write, im:write, im:history, im:read,
#     app_mentions:read, users:read, users:read.email, team:read.
#     chat:write/im:write carry the digest DM; app_mentions:read and im:history/im:read
#     are what let the helper hear a mention or a direct message. Without them the
#     install succeeds and every reply fails with missing_scope.
#     Token rotation may be left on: the app stores the refresh token and exchanges it.
# (2) Helper: the Signing Secret IS required (it authenticates Slack's requests, which
#     carry no club session). In the Slack app set:
#       Slash command  /yucg   ->  $BACKEND_URL/api/slack/commands
#       Event subscriptions    ->  $BACKEND_URL/api/slack/events
#       Subscribe to bot events: app_mention, message.im
#     Slack only reaches a public URL, so the helper works on the deployed app, not a laptop.
# (3) Channel digest only: paste an Access Token (xoxb-...) as SLACK_BOT_TOKEN. This is a
#     fallback for a workspace with rotation off; with rotation on it expires in 12 hours
#     and the app uses the install's refreshed token instead.
# The Verification Token is deprecated and unused; App ID is not used.
# SLACK_CLIENT_ID=your_slack_client_id
# SLACK_CLIENT_SECRET=your_slack_client_secret
# SLACK_SIGNING_SECRET=your_slack_signing_secret
# SLACK_BOT_TOKEN=xoxb-your-bot-access-token
# SLACK_DIGEST_CHANNEL_ID=C01234ABCD
# BACKEND_URL=http://localhost:8000
