# --- SharePoint ------------------------------------------------------------
# mock  = serve ./sample-data (no Azure needed)
# graph = Microsoft Graph, app-only
SHAREPOINT_MODE=mock
# Comma-separated folders (relative to the document library root) Eli may
# read. REQUIRED in graph mode; everything outside is invisible. Mock default: "Past Projects"
SHAREPOINT_ALLOWED_FOLDERS=Past Projects
# Mock mode only: use a different directory as the fake document library (default: ./sample-data).
# MOCK_DATA_DIR=

# --- Graph mode only -------------------------------------------------------
# app       = an Entra app reads the club site (needs a tenant admin; uses the secret below)
# delegated = Eli reads YOUR OneDrive, signed in as you with `npm run eli:microsoft -- login` (no secret)
GRAPH_AUTH=app
# Delegated: "organizations" or your school domain, e.g. yale.edu
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# App mode only
AZURE_CLIENT_SECRET=
# Delegated mode: where the saved Microsoft sign-in lives (gitignored)
# MSAL_CACHE_PATH=.msal-cache.json
# Graph site id, e.g. contoso.sharepoint.com,<siteCollectionGuid>,<webGuid>
# App mode: required. Delegated mode: leave empty to use your own OneDrive.
SHAREPOINT_SITE_ID=
# Optional. Defaults to the site's default document library.
SHAREPOINT_DRIVE_ID=
# Required by Graph /search/query for app-only calls: NAM, EUR, APC, ...
GRAPH_SEARCH_REGION=NAM

# --- Limits ----------------------------------------------------------------
MAX_DOWNLOAD_BYTES=26214400

# ===========================================================================
# Eli (Slack assistant). Keep these secret.
# ===========================================================================
# Slack app -> OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=
# Slack app -> Basic Information -> App-Level Tokens (scope connections:write)
SLACK_APP_TOKEN=
# console.anthropic.com -> a workspace with a monthly spend limit -> API key
ANTHROPIC_API_KEY=

ELI_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
ELI_EFFORT=medium
ELI_MAX_TOKENS=8000
ELI_MAX_TOOL_STEPS=10
ELI_USER_REQUESTS_PER_HOUR=20
ELI_WORKSPACE_REQUESTS_PER_DAY=300
ELI_USAGE_LOG=eli-usage.log
# Optional: only answer in this Slack workspace (T...). Defaults to the token's own workspace.
# ELI_ALLOWED_TEAM_ID=
# on | off: SharePoint/OneDrive tools (uses the SharePoint settings above)
ELI_SHAREPOINT=on
# Path to a Google service-account JSON key. Empty = Google Drive tools off.
ELI_GOOGLE_KEY_FILE=

# Optional: Slack member ids (U...) who may run /eli-stats, comma-separated (profile -> ... -> Copy member ID)
# ELI_ADMIN_USER_IDS=
# View-only access to the web console (board members). Admins can always view it.
# ELI_BOARD_USER_IDS=
# Who /requests pings (comma-separated member ids). Defaults to ELI_ADMIN_USER_IDS; "off" disables /requests.
# ELI_FEATURE_REQUESTS_TO=

# --- Member linking (Slack user -> club member) ------------------------------
# off      = no linking (default)
# local    = test workspace: a roster file you edit; /eli-link matches the Slack profile email to it
# platform = YUCG: ask the YUCG Outreach platform (needs its proposed /api/agent/v1 endpoint; not built yet)
ELI_IDENTITY=off
# on = only linked members can use Eli. off = linking is optional.
ELI_REQUIRE_LINK=off
# local mode (copy eli-members.example.json to eli-members.json; both files below are gitignored)
# ELI_MEMBERS_FILE=eli-members.json
# ELI_LINKS_FILE=eli-links.json
# platform mode
# ELI_PLATFORM_URL=https://<platform address>
# ELI_PLATFORM_TOKEN=<service token from the platform admin, 32+ chars>
# ELI_PLATFORM_LINK_PAGE=https://<platform address>/profile

# on | off: let Eli run a few Anthropic web searches ($10 per 1,000 searches, plus tokens for the results)
ELI_WEB_SEARCH=off
# Searches allowed per question (1-5)
ELI_WEB_SEARCH_MAX_USES=3
# Searches per person per day (resets at midnight in ELI_WEB_SEARCH_TIMEZONE, and when Eli restarts)
ELI_WEB_SEARCHES_PER_USER_PER_DAY=15
# Optional comma lists like example.com or example.com/blog (no https://). Set one or neither, never both.
# ELI_WEB_ALLOWED_DOMAINS=
# ELI_WEB_BLOCKED_DOMAINS=
# ELI_WEB_SEARCH_TOOL=web_search_20250305
# ELI_WEB_SEARCH_TIMEZONE=America/New_York

# Reminders: Slack posts them at the set time, even while Eli is offline. Nothing is scheduled until
# the person who asked presses Schedule on Eli's preview.
ELI_REMINDERS=on
ELI_MAX_REMINDERS_PER_USER=5
# Used only when Slack doesn't give the person's time zone.
ELI_DEFAULT_TIME_ZONE=America/New_York

# Web console for the board: usage, cost, topics and who is using Eli. No question text is stored.
# Board members and admins sign in with a one-time link from /eli-console (or "console" in a DM).
ELI_CONSOLE=off
# Required when on. Generate with: openssl rand -hex 32
ELI_CONSOLE_SECRET=
# Where people open it. Must be https:// unless it's localhost.
# ELI_CONSOLE_URL=http://localhost:8787
# ELI_CONSOLE_PORT=8787
# 127.0.0.1 locally; 0.0.0.0 in a container behind a load balancer
# ELI_CONSOLE_HOST=127.0.0.1
# ELI_CONSOLE_TIME_ZONE=America/New_York
