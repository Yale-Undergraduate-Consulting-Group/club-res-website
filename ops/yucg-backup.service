[Unit]
Description=Verified SQLite backup to the private backups bucket
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/etc/yucg/config.json
ConditionPathExists=/data/clientreach.db
ConditionPathIsMountPoint=/data

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/flock -n /run/lock/yucg-backup.lock /bin/bash /opt/yucg/backup-to-s3.sh /data/clientreach.db
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data /run/lock
RestrictSUIDSGID=true
